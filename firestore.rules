rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role helpers
    function isSuperAdmin() {
      return getUserData().role == 'Super Admin';
    }

    function isGovernment() {
      return getUserData().role == 'Government Admin' || getUserData().role == 'Government';
    }

    function isHospitalAdmin() {
      return getUserData().role == 'Hospital Admin';
    }

    function isDoctor() {
      return getUserData().role == 'Doctor' || getUserData().role == 'Staff';
    }

    function isPatient() {
      return getUserData().role == 'Patient';
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isSuperAdmin() ||
        isGovernment() ||
        isHospitalAdmin() ||
        isDoctor() ||
        (resource.data.role == 'Hospital Admin')
      );

      // Allow self-registration (Patient, Hospital) AND hospital admins creating staff docs
      allow create: if isAuthenticated() && (
        isOwner(userId) ||
        isHospitalAdmin() ||
        isSuperAdmin()
      );

      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        isSuperAdmin() ||
        isHospitalAdmin() ||
        isDoctor()
      );

      allow delete: if false; // Only Admin SDK can delete
    }
    
    match /records/{recordId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isGovernment() ||
        isPatient() ||
        isDoctor() ||
        isHospitalAdmin()
      );
      
      // Patients can create self-reported records; doctors/hospitals can create any
      allow create: if isAuthenticated() && (
        isDoctor() ||
        isHospitalAdmin() ||
        isSuperAdmin() ||
        isPatient()
      );

      allow update: if isAuthenticated() && (
        isDoctor() ||
        isHospitalAdmin() ||
        isSuperAdmin()
      );

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read, write: if isAuthenticated() && (
        isHospitalAdmin() || isSuperAdmin() || isOwner(username)
      );
    }

    match /deletionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.adminUid
      );
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isGovernment() ||
        isHospitalAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
